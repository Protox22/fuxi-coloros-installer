# Preserve checksum-covered bytes, BOMs and original vendor notices.
* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.py text eol=lf
*.md text eol=lf
installer/** -text
installer/*.sh text eol=lf
installer/scripts/*.sh text eol=lf
# Upstream license notice is preserved verbatim, including its whitespace.
installer/bin/platform-tools-windows/NOTICE.txt -whitespace
